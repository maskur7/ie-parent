create policy "policyieparents"
on "public"."users"
as PERMISSIVE
for INSERT
to public
with check (
  email IS NOT NULL AND role = 'parent'
);



create table if not exists public.plans (
  id bigserial primary key,
  title text not null,
  description text not null,
  created_at timestamp with time zone default now(),
  user_id uuid references auth.users(id) on delete cascade
);
-- Tambahkan kolom 'category'
ALTER TABLE plans
ADD COLUMN category TEXT;

-- Tambahkan kolom 'difficulty_level'
ALTER TABLE plans
ADD COLUMN difficulty_level TEXT;

-- Tambahkan kolom 'due_date'
-- timestamp with time zone (timestamptz) adalah tipe data yang baik untuk tanggal dan waktu
-- karena menyimpan informasi zona waktu dan direkomendasikan oleh Supabase.
ALTER TABLE plans
ADD COLUMN due_date TIMESTAMPTZ;

-- Tambahkan kolom 'priority'
-- INTEGER adalah tipe data yang cocok untuk skala prioritas (misalnya, 1-5).
ALTER TABLE plans
ADD COLUMN priority INTEGER;


-- Hanya user yang membuat rencana dapat melihat/mengedit miliknya
create policy "User dapat mengakses rencana miliknya"
on plans
for all
using (auth.uid() = user_id)
with check (auth.uid() = user_id);



create table users (
  id uuid primary key references auth.users(id),
  username text,
  created_at timestamp default now()
);
-- Tambahkan kolom yang dibutuhkan
ALTER TABLE users
ADD COLUMN name TEXT,
ADD COLUMN phone TEXT,
ADD COLUMN updated_at TIMESTAMP;



ALTER TABLE users ENABLE ROW LEVEL SECURITY;

CREATE POLICY "Allow users to update their own data"
ON users
FOR UPDATE
USING (auth.uid() = id)
WITH CHECK (auth.uid() = id);

CREATE POLICY "Allow users to insert their own data"
ON users
FOR INSERT
WITH CHECK (auth.uid() = id);

CREATE POLICY "Allow users to read their own data"
ON users
FOR SELECT
USING (auth.uid() = id);

ALTER TABLE users ADD COLUMN role TEXT DEFAULT 'User';



create table if not exists public.activities (
  id uuid primary key default uuid_generate_v4(),
  user_id uuid references auth.users(id) on delete cascade,
  title text not null,
  description text,
  date timestamp with time zone default timezone('utc'::text, now()),
  color text default 'blue'
);

-- Aktifkan RLS
alter table public.activities enable row level security;

-- Policy agar user hanya bisa akses aktivitasnya sendiri
create policy "User dapat melihat aktivitasnya"
on public.activities for select
using (auth.uid() = user_id);

create policy "User dapat menambahkan aktivitas"
on public.activities for insert
with check (auth.uid() = user_id);



-- Aktifkan RLS
alter table users enable row level security;

-- Hanya pemilik akun yang boleh akses datanya
create policy "User can access own profile"
on users for select using (auth.uid() = id);

create policy "User can update own profile"
on users for update using (auth.uid() = id);



CREATE TABLE learning_styles (
